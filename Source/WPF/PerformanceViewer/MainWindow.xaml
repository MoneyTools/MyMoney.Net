<Window x:Class="PerformanceViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Loaded="OnWindowLoaded"
        Title="Performance Viewer" Height="600" Width="1000">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
            <Button Name="btnClear" Click="BtnClear_Click" Margin="4" MinWidth="80" MinHeight="30">Clear</Button>
            <TextBlock VerticalAlignment="Center" Margin="8,0">Zoom:</TextBlock>
            <Slider Name="zoomSlider" Minimum="0.001" Maximum="1.0" Value="1.0" Width="300" Margin="4" ValueChanged="ZoomSlider_ValueChanged"/>
            <TextBlock Name="txtScale" VerticalAlignment="Center" Margin="8,0"/>
            <TextBlock Name="txtServerStatus" VerticalAlignment="Center" Margin="8,0"/>
        </StackPanel>
    <ScrollViewer Name="scrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Canvas Name="timelineCanvas" Height="400" Background="White"
                    MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                    MouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp"
                    MouseMove="TimelineCanvas_MouseMove"
                    MouseLeave="TimelineCanvas_MouseLeave">
        <Canvas.RenderTransform>
          <ScaleTransform x:Name="CanvasScale" ScaleX="1.0" ScaleY="1.0"/>
        </Canvas.RenderTransform>
      </Canvas>
        </ScrollViewer>
    </DockPanel>
</Window>
