<UserControl x:Class="Walkabout.Views.Controls.ReportsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:c="clr-namespace:Walkabout.Controls"
             xmlns:local="clr-namespace:Walkabout.Views.Controls"  
             xmlns:clr="clr-namespace:System;assembly=mscorlib"
             Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
             xmlns:help="clr-namespace:Walkabout.Help"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             help:HelpService.HelpKeyword="Accounts/BalancingAccounts/"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="350">

  <UserControl.Resources>

    <Style x:Key="NumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
      <Setter Property="c:CalculatorPopup.CalculatorEnabled" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource ListItemForegroundBrush}"/>
      <Setter Property="Padding" Value="5,2"/>
    </Style>

    <Style x:Key="Rows" TargetType="Border">
      <Setter Property="MinWidth" Value="200"/>
      <Setter Property="Margin" Value="5,2,5,2"/>
      <Setter Property="Padding" Value="5,5,5,5"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ListItemForegroundBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,0"/>
      <Setter Property="Padding" Value="2,5"/>
    </Style>

    <Style x:Key="ValueAreaBorder" TargetType="Border">
      <Setter Property="Margin" Value="10,2,20,2"/>
    </Style>

  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel >
      
      <Border x:Name="ReportDateRow" Style="{StaticResource Rows}" >
        <StackPanel>
          <TextBlock x:Name="StartDatePrompt" Text="Report date:" />
          <Border Style="{StaticResource ValueAreaBorder}">
            <DatePicker x:Name="DatePickerReportDate" HorizontalAlignment="Stretch"
                        ToolTip="Enter the date to start the report from"
                        SelectedDateChanged="OnReportDateChanged"/>
          </Border>
        </StackPanel>
      </Border>

      <Border x:Name="ReportEndDateRow" Style="{StaticResource Rows}" >
        <StackPanel>
          <TextBlock Text="Report end date:" />
          <Border Style="{StaticResource ValueAreaBorder}">
            <DatePicker x:Name="DatePickerReportEndDate" HorizontalAlignment="Stretch"
                        ToolTip="Enter the date to end the report"
                        SelectedDateChanged="OnReportEndDateChanged"/>
          </Border>
        </StackPanel>
      </Border>
      
      <Border x:Name="FiscalYearRow" Style="{StaticResource Rows}" >
        <StackPanel>
          <TextBlock Text="Fiscal year:" />
          <Border Style="{StaticResource ValueAreaBorder}">
            <ComboBox x:Name="FiscalYearPicker" HorizontalAlignment="Stretch"
                         ToolTip="Enter the financial year for the report"
                        SelectionChanged="OnFiscalYearChanged"/>
          </Border>
        </StackPanel>
      </Border>

      <Border x:Name="NormalizeCurrencyRow" Style="{StaticResource Rows}" >
        <StackPanel>
          <TextBlock Text="Normalize to currency:" />
          <Border Style="{StaticResource ValueAreaBorder}">
            <ComboBox x:Name="CurrencyPicker" HorizontalAlignment="Stretch"
                         ToolTip="Enter the currency to normalize all numbers to"
                        SelectionChanged="OnCurrencyChanged"/>
          </Border>
        </StackPanel>
      </Border>

      <Border x:Name="ConsolidationRow" Style="{StaticResource Rows}">
        <StackPanel>
          <TextBlock Text="Consolidate securities by:" />
          <Border Style="{StaticResource ValueAreaBorder}">
            <ComboBox x:Name="ConsolidationPicker" HorizontalAlignment="Stretch"
                         ToolTip="Select how you would like consolidation to be applied"
                        SelectionChanged="OnConsolidationChanged"/>
          </Border>
        </StackPanel>
      </Border>

      <Border x:Name="ReportTypeRow" Style="{StaticResource Rows}">
        <StackPanel>
          <TextBlock Text="ReportType:" />
          <Border Style="{StaticResource ValueAreaBorder}">
            <ComboBox x:Name="ReportTypePicker" HorizontalAlignment="Stretch"
                         ToolTip="Select the type of report"
                        SelectionChanged="OnReportTypeChanged"/>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
