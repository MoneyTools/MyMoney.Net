<Window x:Class="Walkabout.Tests.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UIControlsTest"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1280">
  <Window.Resources> 
    <Style TargetType="{x:Type Button}">
      <Setter Property="MinWidth" Value="80"/>
      <Setter Property="MinHeight" Value="50"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Margin" Value="3"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Button Click="OnTestBar">Bar</Button>
      <Button Click="OnTestChart">Chart</Button>
      <Button Click="OnToggleLayout">Layout</Button>
      <Button Click="OnToggleStacked">Stacked</Button>
    </StackPanel>
    
    <Grid x:Name="RootGrid" Margin="20" Grid.Row="1">

    </Grid>
  </Grid>
</Window>
